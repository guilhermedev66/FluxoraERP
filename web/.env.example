# Copy to .env.local (gitignored) to override the default API base URL.
# Left unset in local dev: requests go to /api and are proxied to the backend
# dev server (see vite.config.ts server.proxy) to avoid needing CORS locally.
# Set to an absolute URL (e.g. http://localhost:8080/api) when running the backend via Docker
# without going through the Vite dev server proxy, or when pointing at a deployed API.
VITE_API_BASE_URL=
