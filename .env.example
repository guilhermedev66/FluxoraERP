# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit real secrets.

# Image tags may be replaced with immutable registry tags for a release.
API_IMAGE=fluxora-api:local
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_DB=fluxora
POSTGRES_USER=fluxora
POSTGRES_PASSWORD=
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Must be at least 32 characters. Generate your own, e.g. `openssl rand -base64 48`.
JWT_KEY=
JWT_ISSUER=Fluxora
JWT_AUDIENCE=Fluxora
JWT_EXPIRATION_MINUTES=30

# Safe single-host defaults. Put TLS in a reverse proxy and set its public host/origin here.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
ALLOWED_HOSTS=localhost;127.0.0.1
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Source IP seen by Kestrel for the trusted reverse proxy; leave blank without a proxy.
REVERSE_PROXY_KNOWN_PROXY=

# Keep true only when exactly one API instance owns startup migrations.
DATABASE_APPLY_MIGRATIONS=true

# Business calendar and Quartz schedules (Quartz cron syntax, local to BUSINESS_TIME_ZONE).
BUSINESS_TIME_ZONE=America/Sao_Paulo
AUTOMATION_OVERDUE_CRON=0 5 0 * * ?
AUTOMATION_DASHBOARD_SNAPSHOT_CRON=0 15 0 * * ?

# Optional: only set these to bootstrap the first Admin user on a fresh database.
# Leave blank on subsequent runs - no default admin password ever ships in code.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
