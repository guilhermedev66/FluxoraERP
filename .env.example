# Copy this file to .env and fill in real local values before running `docker compose up`.
# .env is gitignored - never commit real secrets.

POSTGRES_DB=fluxora
POSTGRES_USER=fluxora
POSTGRES_PASSWORD=change-me-locally

# Must be at least 32 characters. Generate your own, e.g. `openssl rand -base64 48`.
JWT_KEY=change-me-to-a-random-32-plus-character-secret
JWT_ISSUER=Fluxora
JWT_AUDIENCE=Fluxora
JWT_EXPIRATION_MINUTES=30

# Optional: only set these to bootstrap the first Admin user on a fresh database.
# Leave blank on subsequent runs - no default admin password ever ships in code.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
